# ReadHorizon 설정 예시 — 복사해서 .env 로 저장하세요 (.env 는 git 에 올라가지 않습니다)

# Claude API 키. 비워 두면 데모 모드(실제 분석 없이 화면 흐름만 확인)로 실행됩니다.
ANTHROPIC_API_KEY=

# live | demo (비우면 키 유무로 자동 결정)
RH_LLM_MODE=
RH_MODEL=claude-opus-5
# low | medium | high | xhigh | max
RH_EFFORT=high

# 마지막 이용 후 이 일수가 지나면 작품·분석 결과 자동 삭제
RH_RETENTION_DAYS=180

# 국립중앙도서관 ISBN 서지정보 API 인증키 (선택). 비우면 서지 검색 비활성화
RH_NL_CERT_KEY=

RH_DB_PATH=data/readhorizon.db
# 파일·붙여넣기 원문 최대 크기(MB)
RH_MAX_UPLOAD_MB=20
# 이 글자 수를 넘는 긴 작품은 관련 문단을 골라 발췌 분석합니다
RH_FULLTEXT_CHAR_LIMIT=200000

# 호출 제한(0이면 끔): 접속 IP별 분당 분석·질문·텍스트 추출 수, 서버 전체 하루 LLM 호출 수, IP별 분당 작품 등록·추출 요청 수
RH_LLM_PER_MINUTE=10
RH_LLM_DAILY_LIMIT=1000
RH_CREATE_PER_MINUTE=30

# 1이면 접속 로그(IP 포함)를 남깁니다. 기본은 남기지 않음
RH_ACCESS_LOG=0

# 리버스 프록시 뒤라면 프록시 주소(쉼표 구분). 호출 제한이 실제 접속 IP로 동작하게 합니다
# FORWARDED_ALLOW_IPS=127.0.0.1

# 이미지·스캔 PDF 텍스트 추출(OCR): 한 번에 올릴 이미지 수, 스캔 PDF 쪽수, 추출에 쓸 effort
RH_OCR_MAX_IMAGES=10
RH_OCR_MAX_PAGES=20
RH_OCR_EFFORT=medium

# 번역·풀이 한 번에 옮길 원문 글자 수(1000~20000). 긴 글은 이 크기의 부분으로 나눠 빠짐없이 옮깁니다
RH_TRANSLATE_PART_CHARS=6000

# 번역·해설 품질 평가(eval-quality) 채점 모델(비우면 RH_MODEL과 같음)과 effort
RH_JUDGE_MODEL=
RH_JUDGE_EFFORT=high

# 모범 해설 예시 파일(JSON). 비우면 기본 예시(readhorizon/analysis/exemplars.json)를 씁니다.
# 교사·전문가가 쓴 예시로 바꿀 때 같은 형식의 파일 경로를 지정하세요
RH_EXEMPLARS_PATH=
